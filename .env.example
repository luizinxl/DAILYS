# ============================================
# dailyS — variáveis de ambiente
# Copie para .env.local e preencha
# ============================================

# --- Supabase (frontend) ---
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key

# --- brapi.dev (cotações da bolsa) ---
# Gere em https://brapi.dev/dashboard
VITE_BRAPI_TOKEN=seu_token_brapi

# ============================================
# ABAIXO: só no BACKEND (Supabase Edge Functions)
# NUNCA colocar no frontend / commitar
# ============================================
# PLUGGY_CLIENT_ID=seu_client_id
# PLUGGY_CLIENT_SECRET=seu_client_secret
# SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
